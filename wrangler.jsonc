{
  "name": "global-ticket-capstone",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ticket-db",
      "database_id": "00000000000000000000000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "APP_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "observability": {
    "enabled": true
  }
}
